<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <instrumentation android:name="ai.vosr.vosr_restore.CameraChecks" android:targetPackage="ai.vosr.vosr_restore" />
    <instrumentation android:name="ai.vosr.vosr_restore.CameraMetadataChecks" android:targetPackage="ai.vosr.vosr_restore" />
</manifest>
